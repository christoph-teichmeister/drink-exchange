#: api/decorators.py
msgid "Authentication required."
msgstr "Anmeldung erforderlich."

#: api/json_body.py
msgid "Requests must be sent as application/json."
msgstr "Anfragen müssen als application/json gesendet werden."

#: api/views.py
msgid "Username and password are required."
msgstr "Benutzername und Passwort sind erforderlich."

#: api/views.py
msgid "Invalid credentials."
msgstr "Ungültiger Benutzername oder Passwort."

#: api/views.py
msgid "Logged out."
msgstr "Abgemeldet."

#: bars/config_views.py
msgid "Please correct the highlighted fields."
msgstr "Bitte die markierten Felder korrigieren."

#: bars/config_views.py
msgid ""
"This drink has recorded trades and cannot be deleted. Adjust its prices "
"instead."
msgstr ""
"Für dieses Getränk gibt es Buchungen, daher kann es nicht gelöscht werden. "
"Passe stattdessen seine Preise an."

#: bars/management/commands/ensure_dev_data.py
msgid "Rush Hour Surge"
msgstr "Rush-Hour-Ansturm"

#: bars/management/commands/ensure_dev_data.py
msgid "Bright lagers and saisons keep pouring as the crowd floods in."
msgstr ""
"Helle Lager und Saisons fließen in Strömen, während die Menge hereinströmt."

#: bars/management/commands/ensure_dev_data.py
msgid "Citrus Focus Shift"
msgstr "Zitrus im Fokus"

#: bars/management/commands/ensure_dev_data.py
msgid "The citrus-forward lineup becomes the one to chase for a limited time."
msgstr "Für kurze Zeit sind die zitrusbetonten Getränke besonders gefragt."

#: bars/management/commands/ensure_dev_data.py
msgid "Harbor Deep Crash"
msgstr "Hafen-Crash"

#: bars/management/commands/ensure_dev_data.py
msgid "A chill settling in makes prices slide as more sips to try."
msgstr "Es wird ruhiger, die Preise rutschen ab und laden zum Probieren ein."

#: bars/management/commands/ensure_dev_data.py
msgid "Rye Focus Blast"
msgstr "Roggen im Fokus"

#: bars/management/commands/ensure_dev_data.py
msgid "North Harbor’s rye and amber pours steal the spotlight."
msgstr "Roggen- und Amber-Biere von North Harbor stehen im Rampenlicht."

#: bars/management/commands/ensure_dev_data.py
msgid "Domstadt Reset"
msgstr "Domstadt-Reset"

#: bars/management/commands/ensure_dev_data.py
msgid "Prices gently drift back toward base as the rush eases."
msgstr ""
"Der Ansturm lässt nach, die Preise gleiten sanft zum Basispreis zurück."

#: bars/management/commands/ensure_dev_data.py
msgid "Radler Warm-Up"
msgstr "Radler-Aufwärmrunde"

#: bars/management/commands/ensure_dev_data.py
msgid "Refreshment builds around spritzers and Radlers."
msgstr "Schorlen und Radler sind als Erfrischung gefragt."

#: bars/management/commands/ensure_dev_data.py
msgid ""
"Populates development fixtures (superuser, bars, drinks, price points, "
"trades)."
msgstr ""
"Legt Entwicklungsdaten an (Superuser, Bars, Getränke, Preispunkte, "
"Buchungen)."

#: bars/management/commands/ensure_dev_data.py
msgid "Development fixtures are available."
msgstr "Entwicklungsdaten sind vorhanden."

