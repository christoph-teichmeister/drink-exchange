# Root environment template for Drink Exchange services. Copy to `.env`; docker compose and Django both read it.
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev superuser created by `manage.py ensure_dev_data` (defaults: admin / admin)
# DJANGO_DEV_SUPERUSER_NAME=admin
# DJANGO_DEV_SUPERUSER_EMAIL=admin@example.com
# DJANGO_DEV_SUPERUSER_PASSWORD=admin

# Production only (config.settings.prod)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://drinks.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_INTERNAL_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
